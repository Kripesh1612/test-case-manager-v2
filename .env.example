# Server
PORT=3001

# JWT — long random string used to sign auth tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Database (Postgres 16). Two options:
#   1. Apt-installed Postgres on localhost (sudo apt install postgresql):
#        DATABASE_URL=postgresql://tcm:tcm@localhost:5432/tcm?schema=public
#   2. Docker Compose (see docker-compose.yml):
#        DATABASE_URL=postgresql://tcm:tcm@localhost:5432/tcm?schema=public
DATABASE_URL=postgresql://tcm:tcm@localhost:5432/tcm?schema=public

# Comma-separated list of emails promoted to admin on signup
ADMIN_EMAILS=cypress-admin@tcm.com

# "open" (default) | "invite"
REGISTRATION_MODE=open

# Days before invite tokens expire
INVITE_TTL_DAYS=7

# Days before trashed rows are auto-purged (0 = never)
TRASH_RETENTION_DAYS=30

# "true" (default) | "false"
AUDIT_ENABLED=true

# Rate limit caps (requests per 60s per IP, per bucket).
#
# Defaults are the production-strict caps (10 login, 3 register per IP
# per minute). These are sane values for a deployed instance. If you
# run the Cypress suite against the same server, set RATE_LIMIT_BURST=1
# to relax to the 200/200 generous values the suite needs. Explicit
# RATE_LIMIT_LOGIN_MAX / RATE_LIMIT_REGISTER_MAX always win.
#   RATE_LIMIT_BURST=1
#   RATE_LIMIT_LOGIN_MAX=10
#   RATE_LIMIT_REGISTER_MAX=3

# HTTP body-size limit for express.json(). 1 MB is plenty for our
# payloads; bump if you start accepting larger blobs.
# JSON_BODY_LIMIT=1mb

# Express trust-proxy hop count. `1` = trust the nearest reverse proxy
# (nginx / Coolify / fly.io). Bump if you put more hops in front.
# TRUST_PROXY=1

# Scheduler tick interval (ms). 60_000 by default. Tests sometimes
# crank it down to a few hundred ms.
# SCHEDULER_TICK_MS=60000

# Set to 1 to disable the in-process scheduler loop entirely (useful
# for CI / one-off jobs that don't want the loop eating CPU).
# SCHEDULER_DISABLED=0

# ================= Feature 1: Webhooks =================
# Master switch for emitting suite.run.completed events (default true).
# WEBHOOKS_ENABLED=true
# Per-event delivery attempts (default 2).
# WEBHOOK_RETRIES=2
# Per-attempt HTTP timeout in ms (default 5000).
# WEBHOOK_TIMEOUT_MS=5000

# ================= Feature 2: Email digest =================
# Opt-in master switch — the loop stays dormant unless DIGEST_ENABLED=1.
# DIGEST_ENABLED=false
# Cron expression for the periodic digest (default '0 8 * * *' = daily 08:00 UTC).
# DIGEST_SCHEDULE=0 8 * * *
# Comma-separated recipients; falls back to ADMIN_EMAILS when unset.
# DIGEST_RECIPIENTS=qa@example.com
# Digest loop poll interval in ms (default 60000; tests tighten it).
# DIGEST_TICK_MS=60000
# SMTP host:port for real email delivery. When unset, digests render as
# .eml artifacts under storage/digests/ so the loop is observable without
# a mail server.
# SMTP_HOST=smtp.example.com:25
