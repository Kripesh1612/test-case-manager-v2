# Server
PORT=3001

# JWT — long random string used to sign auth tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Database (Postgres 16). Two options:
#   1. Apt-installed Postgres on localhost (sudo apt install postgresql):
#        DATABASE_URL=postgresql://tcm:tcm@localhost:5432/tcm?schema=public
#   2. Docker Compose (see docker-compose.yml):
#        DATABASE_URL=postgresql://tcm:tcm@localhost:5432/tcm?schema=public
DATABASE_URL=postgresql://tcm:tcm@localhost:5432/tcm?schema=public

# Comma-separated list of emails promoted to admin on signup
ADMIN_EMAILS=cypress-admin@tcm.com

# "open" (default) | "invite"
REGISTRATION_MODE=open

# Days before invite tokens expire
INVITE_TTL_DAYS=7

# Days before trashed rows are auto-purged (0 = never)
TRASH_RETENTION_DAYS=30

# "true" (default) | "false"
AUDIT_ENABLED=true

# Rate limit caps (requests per 60s per IP, per bucket).
# Defaults are deliberately generous (200) so the Cypress suite isn't
# tripped during a fast CI run — tighten for production. See
# utils/settings.js for the canonical list.
#   RATE_LIMIT_LOGIN_MAX=10
#   RATE_LIMIT_REGISTER_MAX=3

# HTTP body-size limit for express.json(). 1 MB is plenty for our
# payloads; bump if you start accepting larger blobs.
# JSON_BODY_LIMIT=1mb

# Express trust-proxy hop count. `1` = trust the nearest reverse proxy
# (nginx / Coolify / fly.io). Bump if you put more hops in front.
# TRUST_PROXY=1

# Scheduler tick interval (ms). 60_000 by default. Tests sometimes
# crank it down to a few hundred ms.
# SCHEDULER_TICK_MS=60000

# Set to 1 to disable the in-process scheduler loop entirely (useful
# for CI / one-off jobs that don't want the loop eating CPU).
# SCHEDULER_DISABLED=0
