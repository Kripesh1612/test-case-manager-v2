{
  "name": "regress",
  "version": "1.0.0",
  "description": "Regress — catch what changed before your users do. Test case management with version history, flakiness scoring, scheduler, and real Cypress execution.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres && npm run db:wait",
    "db:wait": "node scripts/wait-for-postgres.js",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U tcm -d tcm",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:reset": "docker compose down -v && docker compose up -d --build",
    "cy:open": "RATE_LIMIT_BURST=1 cypress open",
    "cy:run": "RATE_LIMIT_BURST=1 cypress run",
    "cy:run:api": "RATE_LIMIT_BURST=1 cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "cy:run:ui": "RATE_LIMIT_BURST=1 cypress run --spec 'cypress/e2e/ui/**/*.cy.js'",
    "test:unit": "node --test utils/cron.test.js utils/flakiness.test.js utils/diff.test.js utils/executor.test.js utils/webhooks.test.js utils/webhookSecret.test.js utils/auth.test.js utils/digest.test.js utils/visualDiff.test.js middleware/registrationGate.test.js shared/schemas/auth.test.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov --include='utils/**/*.js' --include='middleware/**/*.js' --exclude='**/*.test.js' npm run test:unit",
    "lint": "eslint utils middleware",
    "lint:fix": "eslint --fix utils middleware",
    "openapi": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/openapi-check.mjs",
    "openapi:serve": "node scripts/serve-openapi.mjs",
    "newman": "newman run postman/Test-Case-Manager.postman_collection.json -e postman/Test-Case-Manager.postman_environment.json --reporters cli",
    "test": "RATE_LIMIT_BURST=1 cypress run"
  },
  "keywords": [
    "qa",
    "test-cases",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "c8": "^10.1.3",
    "cypress": "^13.17.0",
    "eslint": "^9.39.4",
    "newman": "^6.2.1",
    "prisma": "^5.22.0",
    "swagger-ui-dist": "^5.32.15"
  }
}
