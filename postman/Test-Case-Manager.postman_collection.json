        {
          "name": "Get one test case",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Verify testCaseId still points to an existing resource; if not (or empty), create one",
                  "const baseUrl = pm.environment.get('baseUrl');",
                  "const token = pm.environment.get('token');",
                  "const tcId = pm.environment.get('testCaseId');",
                  "return new Promise((resolve, reject) => {",
                  "  const create = () => {",
                  "    pm.sendRequest({",
                  "      url: baseUrl + '/test-cases',",
                  "      method: 'POST',",
                  "      header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },",
                  "      body: { mode: 'raw', raw: JSON.stringify({ title: 'Auto fixture ' + Date.now() }) }",
                  "    }, (err, res) => {",
                  "      if (err) return reject(err);",
                  "      try { pm.environment.set('testCaseId', res.json().id); } catch (e) {}",
                  "      resolve();",
                  "    });",
                  "  };",
                  "  if (!tcId) return create();",
                  "  pm.sendRequest({",
                  "    url: baseUrl + '/test-cases/' + tcId,",
                  "    method: 'GET',",
                  "    header: { 'Authorization': 'Bearer ' + token }",
                  "  }, (err, res) => {",
                  "    if (err) return reject(err);",
                  "    if (res.code === 200) resolve();",
                  "    else create();",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('ID matches captured', () => pm.expect(json.id).to.eql(parseInt(pm.environment.get('testCaseId'))));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/test-cases/{{testCaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["test-cases", "{{testCaseId}}"]
            }
          }
