        {
          "name": "Get deleted test case (should 404)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Create + delete a fresh test case so testCaseId points to a deleted resource.",
                  "// This guarantees GET /test-cases/{{testCaseId}} returns 404 — not affected by",
                  "// whatever testCaseId was from previous requests.",
                  "const baseUrl = pm.environment.get('baseUrl');",
                  "const token = pm.environment.get('token');",
                  "return new Promise((resolve, reject) => {",
                  "  pm.sendRequest({",
                  "    url: baseUrl + '/test-cases',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ title: 'To be deleted ' + Date.now() }) }",
                  "  }, (err, createRes) => {",
                  "    if (err) return reject(err);",
                  "    const createdId = createRes.json().id;",
                  "    pm.sendRequest({",
                  "      url: baseUrl + '/test-cases/' + createdId,",
                  "      method: 'DELETE',",
                  "      header: { 'Authorization': 'Bearer ' + token }",
                  "    }, (err2, delRes) => {",
                  "      if (err2) return reject(err2);",
                  "      pm.environment.set('testCaseId', createdId);",
                  "      resolve();",
                  "    });",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
