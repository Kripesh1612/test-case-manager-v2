{
  "info": {
    "_postman_id": "tcm-collection-0001",
    "name": "Test Case Manager API",
    "description": "End-to-end test collection for the Test Case Manager REST API. Auto-registers a user and creates fixtures on demand — every request can be run individually or as a collection run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Collection-level: ensure we have a valid token. If not, register a fresh user.",
          "if (!pm.environment.get('token')) {",
          "  return new Promise((resolve, reject) => {",
          "    const email = 'qa-' + Date.now() + '@example.com';",
          "    pm.environment.set('userEmail', email);",
          "    pm.sendRequest({",
          "      url: pm.environment.get('baseUrl') + '/auth/register',",
          "      method: 'POST',",
          "      header: { 'Content-Type': 'application/json' },",
          "      body: { mode: 'raw', raw: JSON.stringify({ email: email, password: 'hunter22', name: 'QA Bot' }) }",
          "    }, (err, res) => {",
          "      if (err) return reject(err);",
          "      if (res.code === 201) {",
          "        const json = res.json();",
          "        pm.environment.set('token', json.token);",
          "        pm.environment.set('userId', json.user.id);",
          "      }",
          "      resolve();",
          "    });",
          "  });",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "pm.test('Has token', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.test('Has user object', () => pm.expect(json.user).to.be.an('object'));",
                  "pm.environment.set('token', json.token);",
                  "pm.environment.set('userId', json.user.id);",
                  "pm.environment.set('userEmail', json.user.email);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa-{{$timestamp}}@example.com\",\n  \"password\": \"hunter22\",\n  \"name\": \"QA Bot\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
